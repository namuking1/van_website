---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  basePath,
  content,
  languages,
  routeBySlug,
  routeEntries,
  routePath,
} from '../../data/conference.js'

export function getStaticPaths() {
  return languages.flatMap((lang) => routeEntries.map(({ slug }) => ({
    params: { lang, slug: slug || undefined },
  })))
}

const lang = Astro.params.lang
const slug = Astro.params.slug || ''
const route = routeBySlug[slug]
const pageKey = route.key
const copy = content[lang]
const page = copy[pageKey]
const [title, description] = copy.meta[pageKey]
const link = (target) => basePath(routePath(lang, target))
---

<BaseLayout lang={lang} pageKey={pageKey} slug={slug} title={title} description={description}>
  {pageKey === 'home' && (
    <>
      <section class="hero hero--home">
        <div class="noise" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy reveal-block">
            <p class="eyebrow eyebrow--accent">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p class="hero-lead">{page.lead}</p>
            <div class="button-row">
              <a class="button button--accent" href={link('conference/2026')}>{copy.common.details}<span aria-hidden="true">↗</span></a>
              <a class="button button--ghost" href={link('application')}>{copy.common.apply}</a>
            </div>
            <p class="hero-note"><span aria-hidden="true"></span>{page.note}</p>
          </div>
          <div class="hero-stage" aria-label="VAN Conference 2026">
            <div class="stage-orbit stage-orbit--outer" aria-hidden="true"></div>
            <div class="stage-orbit stage-orbit--inner" aria-hidden="true"></div>
            <div class="stage-cross" aria-hidden="true"></div>
            <div class="stage-year">20<br />26</div>
            <div class="stage-label">AI · FINANCE · HEALTH</div>
            <div class="stage-status">{copy.common.planning}</div>
          </div>
        </div>
        <div class="container hero-index" aria-label="Event information">
          <div><span>EDITION</span><strong>2026</strong></div>
          <div><span>{copy.common.schedule}</span><strong>{copy.common.pending}</strong></div>
          <div><span>{copy.common.venue}</span><strong>{copy.common.pending}</strong></div>
          <div><span>LANGUAGE</span><strong>KO · EN</strong></div>
        </div>
      </section>

      <section class="section section--paper">
        <div class="container statement-grid">
          <p class="section-number">01 / PLATFORM</p>
          <div>
            <h2>{page.statementTitle}</h2>
            <p class="section-lead">{page.statementBody}</p>
          </div>
        </div>
      </section>

      <section class="section section--ink">
        <div class="container section-heading">
          <div>
            <p class="eyebrow">02 / PROGRAM</p>
            <h2>{page.tracksTitle}</h2>
          </div>
          <p>{page.tracksLead}</p>
        </div>
        <div class="container track-grid">
          {page.tracks.map(([number, name, body]) => (
            <article class="track-card">
              <span class="track-number">{number}</span>
              <h3>{name}</h3>
              <p>{body}</p>
              <span class="card-mark" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="section section--accent">
        <div class="container bridge">
          <div>
            <p class="eyebrow">YEAR-ROUND PARTNERSHIP</p>
            <h2>{page.bridgeTitle}</h2>
            <p>{page.bridgeBody}</p>
          </div>
          <a class="circle-link" href={link('partners')} aria-label={copy.common.partnership}><span>PARTNER</span><b aria-hidden="true">↗</b></a>
        </div>
      </section>
    </>
  )}

  {pageKey === 'conference' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid">
          <div>
            <p class="eyebrow eyebrow--accent">{page.eyebrow}</p>
            <h1>{page.title}</h1>
          </div>
          <p class="page-lead">{page.lead}</p>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container conference-feature">
          <div class="conference-year">2026</div>
          <div class="conference-card-copy">
            <p class="eyebrow">{copy.common.latest}</p>
            <h2>{page.cardTitle}</h2>
            <p>{page.cardBody}</p>
            <dl class="event-mini-facts">
              <div><dt>{copy.common.schedule}</dt><dd>{copy.common.pending}</dd></div>
              <div><dt>{copy.common.venue}</dt><dd>{copy.common.pending}</dd></div>
              <div><dt>{copy.common.status}</dt><dd>{copy.common.planning}</dd></div>
            </dl>
            <a class="text-link" href={link('conference/2026')}>{copy.common.details}<span aria-hidden="true">↗</span></a>
            <small>{page.permanent}: /{lang}/conference/2026/</small>
          </div>
        </div>
      </section>
      <section class="section section--ink">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">FORMAT</p><h2>{page.frameworkTitle}</h2></div></div>
          <div class="framework-grid">
            {page.framework.map(([title, body], index) => (
              <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  {pageKey === 'conference2026' && (
    <>
      <section class="event-hero">
        <div class="container event-hero-inner">
          <div>
            <p class="eyebrow eyebrow--accent">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p class="hero-lead">{page.lead}</p>
          </div>
          <div class="event-seal" aria-hidden="true"><span>VAN</span><b>2026</b></div>
        </div>
      </section>
      <section class="event-facts">
        <div class="container facts-grid">
          {page.facts.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
        </div>
      </section>
      <section class="section section--paper">
        <div class="container split-content">
          <p class="section-number">01 / OVERVIEW</p>
          <div><h2>{page.overviewTitle}</h2><p class="section-lead">{page.overviewBody}</p></div>
        </div>
      </section>
      <section class="section section--ink">
        <div class="container section-heading">
          <div><p class="eyebrow">02 / TRACKS</p><h2>{page.programTitle}</h2></div>
          <p>{page.programLead}</p>
        </div>
        <div class="container program-list">
          {page.program.map(([name, body], index) => (
            <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{name}</h3><p>{body}</p></article>
          ))}
        </div>
      </section>
      <section class="section section--mist">
        <div class="container notice-panel">
          <div><p class="eyebrow">NEXT UPDATE</p><h2>{page.noticeTitle}</h2><p>{page.noticeBody}</p></div>
          <a class="button button--dark" href={link('application')}>{copy.common.apply}<span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </>
  )}

  {pageKey === 'about' && (
    <>
      <section class="page-hero page-hero--orbital">
        <div class="container page-hero-grid">
          <div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div>
          <p class="page-lead">{page.lead}</p>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">HOW WE WORK</p><h2 class="wide-title">{page.principlesTitle}</h2>
          <div class="principle-grid">
            {page.principles.map(([number, title, body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}
          </div>
        </div>
      </section>
      <section class="section section--accent">
        <div class="container manifesto"><p class="eyebrow">THE VAN CYCLE</p><h2>{page.modelTitle}</h2><p>{page.modelBody}</p></div>
      </section>
    </>
  )}

  {pageKey === 'application' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / PATHS</p><h2 class="wide-title">{page.pathsTitle}</h2>
          <div class="join-grid">
            {page.paths.map(([title, body, status], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p><small>{status}</small></article>)}
          </div>
        </div>
      </section>
      <section class="section section--ink">
        <div class="container process-wrap"><div><p class="eyebrow">02 / PROCESS</p><h2>{page.processTitle}</h2><p>{page.notice}</p></div>
          <ol class="process-list">{page.process.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}</ol>
        </div>
      </section>
    </>
  )}

  {pageKey === 'partners' && (
    <>
      <section class="page-hero page-hero--accent-line">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / COLLABORATE</p><h2 class="wide-title">{page.typesTitle}</h2>
          <div class="partnership-grid">{page.types.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
        </div>
      </section>
      <section class="section section--accent"><div class="container partner-cta"><div><p class="eyebrow">OPEN CALL</p><h2>{page.ctaTitle}</h2><p>{page.ctaBody}</p></div><a class="button button--dark" href={link('contact')}>{copy.common.partnership}<span aria-hidden="true">↗</span></a></div></section>
    </>
  )}

  {pageKey === 'archive' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container archive-feature"><div class="archive-year">2026</div><div><p class="eyebrow">CURRENT RECORD</p><h2>{page.latestTitle}</h2><p>{page.latestBody}</p><a class="text-link" href={link('conference/2026')}>{copy.common.details}<span aria-hidden="true">↗</span></a></div></div>
      </section>
      <section class="section section--ink"><div class="container"><div class="section-heading"><div><p class="eyebrow">INDEX</p><h2>{page.structureTitle}</h2></div><p>{page.empty}</p></div><div class="archive-grid">{page.categories.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
    </>
  )}

  {pageKey === 'contact' && (
    <>
      <section class="page-hero page-hero--contact">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / INQUIRIES</p><h2 class="wide-title">{page.topicsTitle}</h2><div class="contact-grid">{page.topics.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div>
      </section>
      <section class="section section--mist"><div class="container contact-channel"><div><p class="eyebrow">02 / CHANNEL</p><h2>{page.channelTitle}</h2><p>{page.channelBody}</p></div><div class="status-pill"><i aria-hidden="true"></i>{page.channelStatus}</div></div></section>
    </>
  )}
</BaseLayout>

